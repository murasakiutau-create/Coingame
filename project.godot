; Engine configuration file.
; プロジェクト設定。Godot 4.3+ で開いてください。

config_version=5

[application]

config/name="コイン落とし図鑑収集"
config/description="プッシャー型コイン落とし × 図鑑収集ゲーム（プロトタイプ）"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

EventBus="*res://scripts/event_bus.gd"
ItemDatabase="*res://scripts/item_database.gd"
GameManager="*res://scripts/game_manager.gd"

[input]

drop_coin={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/default_gravity=14.0

[rendering]

renderer/rendering_method="forward_plus"
